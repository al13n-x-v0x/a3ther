# ============================================================
# A3THER environment variables — copy to `.env` (gitignored)
# Secrets are resolved ENVIRONMENT FIRST, then config/api_keys.json.
# Never commit a real `.env` file.
# ============================================================

# ---- LLM Gateway (multi-model routing) ----------------------
# OpenAI (also any OpenAI-compatible endpoint via base URL)
A3THER_OPENAI_API_KEY=
A3THER_OPENAI_BASE_URL=
# DeepSeek
A3THER_DEEPSEEK_API_KEY=
# Google Gemini (falls back to config/api_keys.json gemini_api_key)
A3THER_GEMINI_API_KEY=
# Anthropic
A3THER_ANTHROPIC_API_KEY=

# ---- Remote Server Developer Mode (SSH) ----------------------
# When A3THER_SSH_HOST is set, a profile named "env" is synthesised.
A3THER_SSH_HOST=
A3THER_SSH_USER=
A3THER_SSH_PORT=22
A3THER_SSH_KEY_PATH=
A3THER_SSH_PASSWORD=
A3THER_SSH_TIMEOUT=15
