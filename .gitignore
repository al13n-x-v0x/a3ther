# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Build outputs — Briefcase/Gradle keep these HUGE (hundreds of MB); ignore
# the working dirs but keep the requested release artifacts tracked.
scan_apk/build/
scan_apk/logs/
remote_app/build/
remote_app/logs/
*.aab

# Env & secrets — never commit
.env
config/api_keys.json
config/servers.json

# PyInstaller working dir + the built A3THER bundle/exe — the exe ships as
# a GitHub release asset, not in git. The ScanGuard exe under dist/ is
# tracked on purpose.
build/
dist/A3THER/
dist/A3THER.exe
dist/*.zip

# Generated media — video editor renders + downloaded clips
Output/videos/
Output/clips/

# OS junk
Thumbs.db
.DS_Store

# Freebuff local state
.freebuff/
dist/*.zip
